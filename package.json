{
  "name": "bbc-6min-scraper",
  "version": "1.0.0",
  "description": "Scrape the first content link from BBC 6 Minute English",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && pnpm build:css",
    "build:css": "tailwindcss -i ./tailwind/input.css -o ./hugo/static/css/6min.css --minify",
    "start": "pnpm build && node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
