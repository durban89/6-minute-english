# 是否启用同步到另一个 GitHub 仓库（true/1/yes 开启）
GIT_SYNC_ENABLED=false

# 目标仓库地址（SSH 或 HTTPS 均可）
# SSH:   git@github.com:user/hugo-site.git
# HTTPS: https://github.com/user/hugo-site.git
GIT_SYNC_REPO=git@github.com:user/hugo-site.git

# 目标分支（直接提交到该分支，默认 main）
GIT_SYNC_BRANCH=main

# 仓库内放置内容的目录（相对仓库根目录，默认 content/6-minute-english）
GIT_SYNC_CONTENT_DIR=content/6-minute-english

# 本地克隆/缓存仓库的工作目录（可选，默认 tmp/.sync-repo）
# GIT_SYNC_WORKDIR=

# 使用 HTTPS 仓库时的访问令牌（可选；SSH 方式可留空）
# GIT_SYNC_TOKEN=

# 提交信息模板（可选，默认 chore: sync <id> (6 minute english)）
# GIT_SYNC_COMMIT_MESSAGE=

# 提交者信息（可选；不设置则使用仓库既有配置）
# GIT_SYNC_COMMIT_NAME=
# GIT_SYNC_COMMIT_EMAIL=
